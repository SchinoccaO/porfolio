{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
