---
import '../versions/e/e.css';
import { site } from '../content/site';
import Header from '../versions/e/Header.astro';
import Hero from '../versions/e/Hero.astro';
import Statement from '../versions/e/Statement.astro';
import Offer from '../versions/e/Offer.astro';
import Services from '../versions/e/Services.astro';
import Process from '../versions/e/Process.astro';
import Motofix from '../versions/e/Motofix.astro';
import About from '../versions/e/About.astro';
import Contact from '../versions/e/Contact.astro';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F6F1E7" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat+Brush&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('e-js');</script>
  </head>
  <body class="e-root">
    <a class="e-skip" href="#main">Ir al contenido</a>
    <Header />
    <main id="main">
      <Hero />
      <Statement />
      <Offer />
      <Services />
      <Process />
      <Motofix />
      <About />
      <Contact />
    </main>
    <script>
      import '../versions/e/e';
    </script>
  </body>
</html>
