---
import '../versions/c/c.css';
import { site } from '../content/site';
import Hero from '../versions/c/Hero.astro';
import Statement from '../versions/c/Statement.astro';
import Process from '../versions/c/Process.astro';
import Services from '../versions/c/Services.astro';
import Motofix from '../versions/c/Motofix.astro';
import About from '../versions/c/About.astro';
import Works from '../versions/c/Works.astro';
import Contact from '../versions/c/Contact.astro';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#6E0A0C" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Mrs+Saint+Delafield&family=Special+Elite&display=swap" />
  </head>
  <body class="c-page">
    <main>
      <Hero />
      <Statement />
      <Process />
      <Services />
      <Motofix />
      <About />
      <Works />
      <Contact />
    </main>
    <script>import '../versions/c/deck.ts';</script>
  </body>
</html>
