---
import 'animate.css/animate.min.css';
import '../styles/global.css';
import { site } from '../content/site';
import SiteApp from '../components/SiteApp';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#1B1030" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=JetBrains+Mono:wght@400;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteApp client:load />
  </body>
</html>
