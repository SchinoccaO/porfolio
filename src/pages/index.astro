---
// Prototype switcher route: ?v=1|2. Variants are React components; the
// active one is chosen client-side so one static page serves both.
import { site } from '../content/site';
import PrototypeApp from '../prototype/PrototypeApp';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:wght@400;500;700&family=Caveat:wght@600&display=swap"
    />
  </head>
  <body>
    <PrototypeApp client:load />
  </body>
</html>
