---
import '../versions/e/e.css';
import { site } from '../content/site';
import Header from '../versions/e/Header.astro';
import Hero from '../versions/e/Hero.astro';
import Statement from '../versions/e/Statement.astro';
import Offer from '../versions/e/Offer.astro';
import Services from '../versions/e/Services.astro';
import Process from '../versions/e/Process.astro';
import Motofix from '../versions/e/Motofix.astro';
import About from '../versions/e/About.astro';
import Contact from '../versions/e/Contact.astro';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F6F1E7" />
    <link rel="canonical" href="https://orianaschinocca.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Oriana Schinocca" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content="https://orianaschinocca.com/" />
    <meta property="og:image" content="https://orianaschinocca.com/og.png?v=2" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Oriana Schinocca, desarrolladora full stack. Desarrollo web para negocios" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': 'https://orianaschinocca.com/#oriana',
            name: site.name,
            url: 'https://orianaschinocca.com/',
            image: 'https://orianaschinocca.com/e/oriana.webp',
            jobTitle: 'Desarrolladora full stack y analista funcional',
            description: site.description,
            address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
            knowsAbout: ['Desarrollo web', 'React', 'Node.js', 'Express', 'Python', 'SQL', 'MongoDB', 'TypeScript', 'Astro', 'Análisis funcional'],
            sameAs: site.socials.map((s) => s.href),
            owns: { '@id': 'https://motofix.ar/#org' },
          },
          {
            '@type': 'ProfessionalService',
            '@id': 'https://orianaschinocca.com/#servicio',
            name: 'Oriana Schinocca · Desarrollo web',
            url: 'https://orianaschinocca.com/',
            image: 'https://orianaschinocca.com/og.png?v=2',
            description: 'Sitios web a medida para negocios y emprendedores, con dominio propio y sistemas a medida.',
            areaServed: { '@type': 'Country', name: 'Argentina' },
            address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
            founder: { '@id': 'https://orianaschinocca.com/#oriana' },
            inLanguage: 'es-AR',
          },
          {
            '@type': 'Organization',
            '@id': 'https://motofix.ar/#org',
            name: 'MotoFIX',
            url: 'https://motofix.ar/',
            description: 'Talleres, gomerías, repuestos y grúas para tu moto.',
            founder: { '@id': 'https://orianaschinocca.com/#oriana' },
          },
          {
            '@type': 'WebSite',
            '@id': 'https://orianaschinocca.com/#web',
            url: 'https://orianaschinocca.com/',
            name: 'Oriana Schinocca',
            inLanguage: 'es-AR',
            publisher: { '@id': 'https://orianaschinocca.com/#oriana' },
          },
        ],
      })}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Caveat+Brush&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('e-js');</script>
  </head>
  <body class="e-root">
    <a class="e-skip" href="#main">Ir al contenido</a>
    <Header />
    <main id="main">
      <Hero />
      <Statement />
      <Offer />
      <Services />
      <Process />
      <Motofix />
      <About />
      <Contact />
    </main>
    <div class="e-bar" data-e-sticky aria-hidden="true">
      <a class="e-btn" href={site.hero.cta.href} tabindex="-1">{site.hero.cta.label} <span aria-hidden="true">→</span></a>
    </div>
    <script>
      import '../versions/e/e';
    </script>
  </body>
</html>
