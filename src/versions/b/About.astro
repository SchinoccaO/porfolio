---
import { site } from '../../content/site';
const a = site.about;
---
<section class="b-about" id="sobre-mi">
  <div class="b-about__grid">
    <div class="b-about__head b-reveal">
      <h2 class="b-h2">{a.title}</h2>
      <svg class="b-sign" viewBox="0 0 260 90" aria-label={site.name} role="img">
        <path pathLength="1" d="M12 62 C 22 14, 48 8, 44 44 C 41 72, 22 74, 36 46 C 52 14, 76 30, 62 58 C 58 66, 70 64, 78 48 C 84 36, 92 40, 90 52 C 88 62, 100 60, 106 46 C 110 38, 116 42, 114 54 C 124 40, 134 36, 136 50 C 138 62, 150 52, 156 40 C 162 30, 170 36, 164 54 C 176 40, 190 34, 192 48 C 193 60, 206 56, 214 44" />
        <path pathLength="1" class="b-sign__under" d="M20 76 C 80 70, 150 82, 248 66" />
      </svg>
    </div>
    <div class="b-about__body b-reveal">
      {a.paragraphs.map((p, i) => <p class={`b-about__p b-about__p--${i}`}>{p}</p>)}
      <p class="b-about__skills"><span class="b-about__skills-title">{a.skillsTitle}</span> {a.skills.join(' / ')}</p>
    </div>
  </div>
</section>
