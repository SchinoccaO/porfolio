---
import { site } from '../../content/site';
import Doodle from './Doodle.astro';
const a = site.about;
const skills = a.skills;
const last = skills[skills.length - 1];
const init = skills.slice(0, -1);
---
<section class="b-about" id="sobre-mi">
  <div class="b-card b-reveal">
    <div class="b-desk" aria-hidden="true">
      <div class="b-desk__sun"></div>
      <div class="b-desk__notebook"><i></i><i></i><i></i><i></i></div>
      <div class="b-desk__laptop"><div class="b-desk__screen"><span></span><span></span><span></span></div><div class="b-desk__base"></div></div>
      <div class="b-desk__mug"><span class="b-desk__steam"></span></div>
      <div class="b-desk__pencil"></div>
      <div class="b-desk__plant"><b></b><b></b><b></b></div>
      <div class="b-desk__top"></div>
      <Doodle kind="heart" class="b-desk__heart" />
    </div>
    <h2 class="b-h2">{a.title}</h2>
    {a.paragraphs.map((p, i) => <p class={`b-about__p b-about__p--${i}`}>{p}</p>)}
    <p class="b-about__skills">{a.skillsTitle}: {init.map((s) => <><b>{s}</b>{', '}</>)}<b>{last}</b>.</p>
    <div class="b-about__sign">
      <svg class="b-sign" viewBox="0 0 260 90" aria-hidden="true">
        <path pathLength="1" d="M12 62 C 22 14, 48 8, 44 44 C 41 72, 22 74, 36 46 C 52 14, 76 30, 62 58 C 58 66, 70 64, 78 48 C 84 36, 92 40, 90 52 C 88 62, 100 60, 106 46 C 110 38, 116 42, 114 54 C 124 40, 134 36, 136 50 C 138 62, 150 52, 156 40 C 162 30, 170 36, 164 54 C 176 40, 190 34, 192 48 C 193 60, 206 56, 214 44" />
        <path pathLength="1" class="b-sign__under" d="M20 76 C 80 70, 150 82, 248 66" />
      </svg>
      <span class="b-about__place">{a.place}</span>
    </div>
    <p class="b-about__small">{a.smallLine}</p>
  </div>
</section>
