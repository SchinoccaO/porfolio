---
import { site } from '../../content/site';
const m = site.motofix;
const work = site.works.items[0];
---
<section class="b-moto" id="motofix">
  <div class="b-moto__in">
    <div class="b-moto__head b-reveal">
      <span class="b-script b-moto__kicker">{m.kicker}</span>
      <h2 class="b-moto__title">{m.title}</h2>
      <p class="b-moto__kind">{work.kind}. {work.desc}</p>
    </div>
    <div class="b-moto__grid">
      <div class="b-moto__text b-reveal">
        <p class="b-moto__lead">{m.lead}</p>
        <p>{m.summary}</p>
        <a class="b-btn b-btn--ink" href={work.href} target="_blank" rel="noopener">{m.cta.label}<span class="b-btn__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
