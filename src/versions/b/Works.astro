---
import { site } from '../../content/site';
import Doodle from './Doodle.astro';
const w = site.works;
const [main, ...soon] = w.items;
---
<section class="b-works" id="trabajos">
  <svg class="b-works__wave" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 L0 22 C 40 -2, 80 -2, 120 20 S 200 42, 240 20 S 330 -4, 400 18 L400 40 Z" /></svg>
  <div class="b-works__band">
    <h2 class="b-h2 b-works__title b-reveal">{w.title}</h2>
    <div class="b-works__stage">
      <a class="b-win b-reveal" href={main.href} target="_blank" rel="noopener">
        <span class="b-win__bar" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="b-win__body">
          <span class="b-win__kind">{main.kind}</span>
          <strong class="b-win__name">{main.name}</strong>
          <span class="b-win__desc">{main.desc}</span>
        </span>
      </a>
      {soon.map((s, i) => (
        <div class={`b-slot b-slot--${i} b-reveal`}>
          <strong>{s.name}</strong>
          <span>{s.desc}</span>
        </div>
      ))}
      <Doodle kind="flower" class="b-works__flower" />
      <Doodle kind="asterisk" class="b-works__ast" />
    </div>
  </div>
</section>
