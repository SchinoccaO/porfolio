---
// Two hand-drawn doodles, decorative only.
interface Props { kind: 'asterisk' | 'sun'; class?: string }
const { kind, class: cls = '' } = Astro.props;
---
<svg class={`b-doodle b-doodle--${kind} ${cls}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {kind === 'asterisk' && (
    <g stroke="currentColor" stroke-width="13" stroke-linecap="round" fill="none">
      <path d="M50 10 L51 90" /><path d="M14 30 L87 71" /><path d="M86 28 L13 72" />
    </g>
  )}
  {kind === 'sun' && (
    <g fill="currentColor" stroke="currentColor">
      <circle cx="50" cy="50" r="22" stroke="none" />
      <g stroke-width="7" stroke-linecap="round" fill="none">
        <path d="M50 8 L50 20" /><path d="M50 80 L50 92" /><path d="M8 50 L20 50" /><path d="M80 50 L92 50" />
        <path d="M20 20 L28 28" /><path d="M72 72 L80 80" /><path d="M80 20 L72 28" /><path d="M28 72 L20 80" />
      </g>
    </g>
  )}
</svg>
