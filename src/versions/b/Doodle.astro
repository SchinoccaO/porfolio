---
// Hand-drawn-feeling sticker doodles. Decorative only.
interface Props { kind: 'asterisk' | 'flower' | 'sun' | 'squig' | 'heart'; class?: string }
const { kind, class: cls = '' } = Astro.props;
---
<svg class={`b-doodle b-doodle--${kind} ${cls}`} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  {kind === 'asterisk' && (
    <g stroke="currentColor" stroke-width="13" stroke-linecap="round" fill="none">
      <path d="M50 10 L51 90" /><path d="M14 30 L87 71" /><path d="M86 28 L13 72" />
    </g>
  )}
  {kind === 'flower' && (
    <g fill="currentColor">
      <circle cx="50" cy="22" r="19" /><circle cx="78" cy="42" r="19" /><circle cx="68" cy="75" r="19" />
      <circle cx="32" cy="75" r="19" /><circle cx="22" cy="42" r="19" />
      <circle cx="50" cy="52" r="13" fill="var(--b-butter)" />
    </g>
  )}
  {kind === 'sun' && (
    <g fill="currentColor" stroke="currentColor">
      <circle cx="50" cy="50" r="22" stroke="none" />
      <g stroke-width="7" stroke-linecap="round" fill="none">
        <path d="M50 8 L50 20" /><path d="M50 80 L50 92" /><path d="M8 50 L20 50" /><path d="M80 50 L92 50" />
        <path d="M20 20 L28 28" /><path d="M72 72 L80 80" /><path d="M80 20 L72 28" /><path d="M28 72 L20 80" />
      </g>
    </g>
  )}
  {kind === 'squig' && (
    <path d="M6 54 C 18 20, 30 20, 38 50 S 58 80, 68 46 S 86 22, 95 48" stroke="currentColor" stroke-width="9" stroke-linecap="round" fill="none" />
  )}
  {kind === 'heart' && (
    <path d="M50 88 C 10 58, 8 24, 32 19 C 44 17, 50 28, 50 32 C 50 28, 58 17, 70 19 C 94 24, 90 58, 50 88 Z" fill="currentColor" />
  )}
</svg>
