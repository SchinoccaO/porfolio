---
import { site } from '../../content/site';
import Doodle from './Doodle.astro';
const o = site.offer;
---
<section class="b-offer" id="que-te-doy">
  <svg class="b-offer__wave" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 L0 22 C 40 -2, 80 -2, 120 20 S 200 42, 240 20 S 330 -4, 400 18 L400 40 Z" /></svg>
  <div class="b-offer__band">
    <div class="b-offer__grid">
      <div class="b-offer__intro b-reveal">
        <h2 class="b-h2">{o.title}</h2>
        <p class="b-offer__lead">{o.lead}</p>
      </div>
      <div class="b-offer__main b-reveal">
        <p>{o.own}</p>
        <blockquote class="b-offer__inpi b-script">
          <Doodle kind="asterisk" class="b-offer__ast" />{o.inpi}
        </blockquote>
      </div>
      <div class="b-offer__logic b-reveal">
        <h3 class="b-offer__logic-title">{o.logicTitle}</h3>
        <p>{o.logic}</p>
      </div>
    </div>
  </div>
</section>
