---
import { site } from '../../content/site';
import { bNav } from './nav';
const c = site.contact;
const f = c.fields;
// Placeholder channels (value starts with "TODO") are never shown.
const channels = c.channels.filter((ch) => !ch.value.startsWith('TODO'));
---
<section class="b-contact" id="contacto">
  <h2 class="b-h2 b-reveal">{c.title}</h2>
  <p class="b-contact__intro b-reveal">{c.intro}</p>
  <form class="b-form b-reveal" data-b-form>
    <label class="b-field"><span>{f.type}</span>
      <select name="type">{f.typeOptions.map((o) => <option>{o}</option>)}</select>
    </label>
    <label class="b-field"><span>{f.deadline}</span>
      <input name="deadline" type="text" placeholder={f.deadlinePlaceholder} />
    </label>
    <label class="b-field"><span>{f.problem}</span>
      <textarea name="problem" rows="4" placeholder={f.problemPlaceholder}></textarea>
    </label>
    <button class="b-btn" type="submit">{f.submit}<span class="b-btn__arrow" aria-hidden="true">→</span></button>
    {/* TODO: no backend yet (see site.contact.todoNote, intentionally not rendered). Submit is a no-op. */}
  </form>
  {channels.length > 0 && (
    <ul class="b-channels b-reveal">
      {channels.map((ch) => <li><span class="b-script">{ch.label}</span> {ch.value}</li>)}
    </ul>
  )}
  <footer class="b-footer">
    <p>{site.footer}</p>
    <nav aria-label="Pie">{bNav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}</nav>
  </footer>
</section>
