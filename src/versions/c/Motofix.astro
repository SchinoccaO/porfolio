---
import { site } from '../../content/site';
const m = site.motofix;
const frames = [m.built[1], m.built[7], m.built[8]];
const rest = m.built.filter((b) => !frames.includes(b));
---
<section class="c-slide c-motofix" id="motofix">
  <p class="c-script c-motofix__kicker c-reveal">{m.kicker}</p>
  <h2 class="c-motofix__title c-reveal" aria-label={m.title}><span aria-hidden="true">{m.title.toUpperCase()}</span></h2>
  <div class="c-polas">
    <figure class="c-pola c-pola--1 c-reveal" style="--r:-5deg">
      <i class="c-tape"></i>
      <div class="c-pola__art c-art-search"><b></b><u></u><u></u><u></u></div>
      <figcaption>{frames[0]}</figcaption>
    </figure>
    <figure class="c-pola c-pola--2 c-reveal" style="--r:4deg">
      <i class="c-tape"></i>
      <div class="c-pola__art c-art-qr"></div>
      <figcaption>{frames[1]}</figcaption>
    </figure>
    <figure class="c-pola c-pola--3 c-reveal" style="--r:-2deg">
      <i class="c-tape"></i>
      <div class="c-pola__art c-art-plane"><b></b></div>
      <figcaption>{frames[2]}</figcaption>
    </figure>
  </div>
  <div class="c-motofix__text c-reveal">
    <p class="c-lead">{m.lead}</p>
    <p>{m.why}</p>
    <p class="c-built"><strong>{m.builtTitle}:</strong> {rest.join(', ')}, y lo que ves pegado arriba.</p>
    <p class="c-motofix__status">{m.status}</p>
    <a class="c-cta c-cta--cream" href={m.cta.href} rel="noopener">{m.cta.label}<span aria-hidden="true"> ↗</span></a>
  </div>
</section>
