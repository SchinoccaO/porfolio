---
import { site } from '../../content/site';
const c = site.contact;
const f = c.fields;
---
<section class="c-slide c-contact" id="contacto">
  <img class="c-contact__photo" data-parallax="-0.05" src="/c/oriana.webp" width="1100" height="1449" alt="" loading="lazy" />
  <div class="c-contact__main">
    <p class="c-script c-contact__hablemos c-reveal" aria-hidden="true">Hablemos</p>
    <h2 class="c-title c-reveal">{c.title}</h2>
    <p class="c-lead c-reveal">{c.intro}</p>
    <form class="c-form c-reveal" action="#">
      <label>{f.type}
        <select name="tipo">{f.typeOptions.map((o) => <option>{o}</option>)}</select>
      </label>
      <label>{f.deadline}
        <input type="text" name="plazo" placeholder={f.deadlinePlaceholder} />
      </label>
      <label>{f.problem}
        <textarea name="problema" rows="3" placeholder={f.problemPlaceholder}></textarea>
      </label>
      <button type="submit" class="c-cta c-cta--cream">{f.submit}<span aria-hidden="true"> →</span></button>
    </form>
    <ul class="c-channels c-reveal">
      {c.channels.map((ch) => <li><b>{ch.label}</b> {ch.value}</li>)}
    </ul>
    <p class="c-footer">{site.footer}</p>
  </div>
</section>
