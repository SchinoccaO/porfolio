---
import { site } from '../../content/site';
const [tpl, custom] = site.services.plans;
---
<section class="c-slide c-services" id="servicios">
  <header class="c-services__head c-reveal">
    <h2 class="c-title">{site.services.title}</h2>
    <p>{site.services.intro}</p>
  </header>
  <div class="c-split">
    <article class="c-panel c-panel--tpl c-reveal">
      <h3>{tpl.name}</h3>
      <p class="c-panel__pitch">{tpl.pitch}</p>
      <p>{tpl.desc}</p>
      <ul class="c-typed">
        {tpl.items.map((it) => <li>{it}</li>)}
      </ul>
    </article>
    <article class="c-panel c-panel--custom c-reveal">
      <h3>{custom.name}</h3>
      <p class="c-panel__pitch">{custom.pitch}</p>
      <p>{custom.desc}</p>
      <p class="c-panel__sentence">{custom.items.join('. ')}.</p>
      <p class="c-stamp"><span>{site.services.price}</span></p>
    </article>
  </div>
  <div class="c-extras c-reveal">
    <h3 class="c-script">{site.services.extrasTitle}</h3>
    <ul class="c-typed c-typed--ink">
      {site.services.extras.map((e) => <li>{e}</li>)}
    </ul>
    <div class="c-notes">
      <p class="c-notes__t">{site.services.notesTitle}</p>
      {site.services.notes.map((n) => <p>{n}</p>)}
    </div>
  </div>
</section>
