---
import { site } from '../../content/site';
const s = site.services;
---
<section class="e-panel e-panel--ink e-services" id="servicios">
  <div class="e-wrap">
    <h2 class="e-h2 e-reveal">{s.title}</h2>

    <div class="e-plans e-reveal">
      {s.plans.map((plan) => (
        <article class="e-plan">
          <h3 class="e-plan__name">{plan.name}</h3>
          <p class="e-plan__pitch">{plan.pitch}</p>
          <p class="e-plan__desc">{plan.desc}</p>
          <ul class="e-plan__list">{plan.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>

    <p class="e-services__quote e-reveal">{s.price}.</p>

    <div class="e-services__more e-reveal">
      <i class="e-tape e-tape--c" aria-hidden="true"></i>
      <div>
        <h3 class="e-h3">{s.extrasTitle}</h3>
        <ul class="e-extras">{s.extras.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="e-notes">
        <h3 class="e-h3">{s.notesTitle}</h3>
        {s.notes.map((n) => <p>{n}</p>)}
      </div>
    </div>
  </div>
</section>
