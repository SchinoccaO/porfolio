---
import { site } from '../../content/site';
const a = site.about;
const t = a.tech;
// Text between ** ** becomes bold (the technology names).
const rich = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<section class="e-panel e-panel--paper e-about" id="sobre-mi">
  <div class="e-wrap e-about__grid">
    <div class="e-about__photo e-reveal">
      <div class="e-frame">
        <i class="e-tape e-tape--a" aria-hidden="true"></i>
        <i class="e-tape e-tape--b" aria-hidden="true"></i>
        <div class="e-frame__oval">
          <img src="/e/oriana-oval.webp" width="800" height="1000" alt={a.ovalAlt} loading="lazy" />
        </div>
      </div>
    </div>
    <div class="e-about__body e-reveal">
      <h2 class="e-h2">{a.title}</h2>
      {a.paragraphs.map((p) => <p>{p}</p>)}
      <div class="e-tech">
        <h3 class="e-h3">{t.title}</h3>
        {t.items.map((p) => <p set:html={rich(p)} />)}
        <p class="e-tech__more">{t.more}</p>
      </div>
    </div>
  </div>
</section>
