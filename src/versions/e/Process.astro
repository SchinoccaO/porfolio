---
import { site } from '../../content/site';
const p = site.process;
---
<section class="e-panel e-panel--paper e-process" id="como-trabajo">
  <div class="e-wrap">
    <h2 class="e-h2 e-reveal">{p.title}</h2>
    <div class="e-path e-reveal">
      <svg class="e-path__line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M20 11 C 20 22, 80 22, 80 37 C 80 52, 20 48, 20 63 C 20 78, 80 76, 80 89" />
      </svg>
      {p.steps.map((s, i) => (
        <div class={`e-step e-step--${i}`}>
          <span class="e-step__node" aria-hidden="true">{i + 1}</span>
          <div class="e-step__text"><h3>{s.title}</h3><p>{s.text}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
