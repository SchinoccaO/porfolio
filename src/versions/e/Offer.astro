---
import { site } from '../../content/site';
const o = site.offer;
// Emphasise the four capabilities inside the paragraph instead of repeating them as chips.
const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const emphasis = ['Formularios', 'calendario de reservas', 'control de stock', 'tienda online'];
const logicHtml = o.logic.replace(new RegExp(`(${emphasis.map(esc).join('|')})`, 'g'), '<strong>$1</strong>');
---
<section class="e-panel e-panel--paper e-offer" id="que-te-doy">
  <div class="e-wrap e-offer__grid">
    <div class="e-offer__intro e-reveal">
      <h2 class="e-h2">{o.title}</h2>
      <p class="e-lead">{o.lead}</p>
    </div>
    <div class="e-offer__main e-reveal">
      <p>{o.own}</p>
      <p class="e-note">{o.inpi}</p>
    </div>
    <div class="e-offer__logic e-reveal">
      <h3 class="e-h3">{o.logicTitle}</h3>
      <p set:html={logicHtml} />
    </div>
  </div>
</section>
