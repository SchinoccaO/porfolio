---
import { site } from '../../content/site';
const h = site.hero;
const [before, after] = h.title.split(h.scribbleWord);
// Each word gets an incremental index so CSS can stagger the single entrance.
let n = 0;
const words = (text: string) => text.trim().split(/\s+/).map((w) => ({ w, i: n++ }));
const w1 = words(before);
const webIndex = n++;
const w2 = words(after);
---
<section class="e-hero" id="top">
  <div class="e-hero__copy">
    <h1 class="e-hero__title">
      <span class="e-hero__t1">{w1.map(({ w, i }) => <span class="e-w" style={`--i:${i}`}>{w}</span>)} <span class="e-w e-script e-hero__web" style={`--i:${webIndex}`}>{h.scribbleWord}</span></span>
      <span class="e-hero__t2">{w2.map(({ w, i }) => <span class="e-w" style={`--i:${i}`}>{w}</span>)}</span>
    </h1>
    <p class="e-hero__sub">{h.sub}</p>
    <a class="e-btn e-hero__cta" href={h.cta.href} data-e-hero-cta>{h.cta.label}<span aria-hidden="true">→</span></a>
  </div>

  <div class="e-stage">
    <div class="e-stage__blob" aria-hidden="true"></div>
    <div class="e-photo" data-parallax="-0.05">
      <img src="/e/oriana.webp" width="1100" height="1449" alt={h.photoAlt} fetchpriority="high" />
    </div>
  </div>
</section>
