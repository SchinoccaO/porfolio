---
import { site } from '../../content/site';
const [l1, l2] = site.statement;
const word = site.statementScribble;
const rest = l2.replace(word, '').trim();
---
<section class="e-panel e-panel--violet e-statement" aria-label="Lo que hago">
  <div class="e-wrap">
    <p class="e-statement__a e-reveal"><span class="e-statement__dead">{l1}<svg viewBox="0 0 200 30" preserveAspectRatio="none" aria-hidden="true"><path d="M2 18 C 50 6, 120 26, 198 10" /></svg></span></p>
    <p class="e-statement__b e-reveal">{rest} <span class="e-script e-statement__word">{word}</span></p>
    <p class="e-statement__story e-reveal">{site.story}</p>
  </div>
</section>
